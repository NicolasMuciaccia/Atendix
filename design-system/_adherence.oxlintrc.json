        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|label|value|delta|direction|sentiment|chart|data|onClick|style|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: icon, tone, label, value, delta, direction, sentiment, chart, data, onClick, style."
