      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline|solid|inverse)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline' | 'solid' | 'inverse'."
      },
